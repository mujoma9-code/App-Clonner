	</array>

	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>dev.clonner.adshield</string>
	<key>PayloadUUID</key>
	<string>AEFD2441-F25B-4487-A182-7DA278AA87EA</string>
	<key>PayloadDisplayName</key>
	<string>Clonner Ad Shield</string>
	<key>PayloadDescription</key>
	<string>Blocks ad and tracker domains across every app on this device by sending DNS lookups to AdGuard's filtering resolver over encrypted HTTPS. Remove it any time in Settings - General - VPN and Device Management.</string>
